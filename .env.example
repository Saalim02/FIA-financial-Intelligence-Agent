# Financial Intelligence Agent configuration

# Local Qwen + QLoRA reasoning
FINANCIAL_REASONING_PROVIDER=qwen
QWEN_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
QWEN_ADAPTER_PATH=fine_tuning/output
QWEN_LOAD_ADAPTER=true
QWEN_4BIT=true
QWEN_DEVICE=auto
QWEN_REQUIRE_ADAPTER=false

# OpenAI is used by guardrail classifiers and optional RAGAS evaluation.
OPENAI_API_KEY=

# Optional LangSmith tracing
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=financial-intelligence-agent
